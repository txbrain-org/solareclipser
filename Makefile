$(PANDOC_BIN):
	@printf "$(info):pandoc\n"
	mkdir -p $(TOOLS)
	curl -fsSL -o $(TOOLS)/$(PANDOC_TGZ) \
		https://github.com/jgm/pandoc/releases/download/$(PANDOC_VER)/$(PANDOC_TGZ)
	echo "$(PANDOC_SHA256)  $(TOOLS)/$(PANDOC_TGZ)" | sha256sum -c -
	tar -xzf $(TOOLS)/$(PANDOC_TGZ) -C $(TOOLS)
	rm $(TOOLS)/$(PANDOC_TGZ)

